@{
    ViewData["Title"] = "Dashboard";
}

<div class="row">
    <div class="col-12">
        <h2><i class="fas fa-tachometer-alt"></i> Dashboard Inventory Management System</h2>
        <p class="text-muted">Selamat datang di Inventory Management System</p>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h5>Total Kategori</h5>
                        <h2>@ViewBag.TotalKategori</h2>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-tags fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h5>Total Barang</h5>
                        <h2>@ViewBag.TotalBarang</h2>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-box fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h5>Total Stok</h5>
                        <h2>@ViewBag.TotalStok</h2>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-cubes fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-plus-circle"></i> Menu Transaksi</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="@Url.Action("CreateBarangMasuk", "Transaksi")" class="btn btn-success">
                        <i class="fas fa-arrow-down"></i> Input Barang Masuk
                    </a>
                    <a href="@Url.Action("CreateBarangKeluar", "Transaksi")" class="btn btn-warning">
                        <i class="fas fa-arrow-up"></i> Input Barang Keluar
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-cog"></i> Menu Master Data</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="@Url.Action("Index", "Kategori")" class="btn btn-primary">
                        <i class="fas fa-tags"></i> Kelola Kategori
                    </a>
                    <a href="@Url.Action("Index", "Barang")" class="btn btn-primary">
                        <i class="fas fa-box"></i> Kelola Barang
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
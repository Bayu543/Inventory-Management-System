@model IEnumerable<InventarisKKP.Models.Barang>

@{
    ViewData["Title"] = "Laporan Inventaris";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-chart-bar"></i> Laporan Inventaris</h2>
    <button onclick="window.print()" class="btn btn-secondary">
        <i class="fas fa-print"></i> Cetak
    </button>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>No</th>
                        <th>Nama Barang</th>
                        <th>Kategori</th>
                        <th>Stok</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.Any() == true)
                    {
                        int no = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@no</td>
                                <td>@item.NamaBarang</td>
                                <td>@item.Kategori?.NamaKategori</td>
                                <td class="text-center">
                                    <span class="badge @(item.Stok > 10 ? "bg-success" : item.Stok > 0 ? "bg-warning" : "bg-danger")">
                                        @item.Stok
                                    </span>
                                </td>
                                <td>
                                    @if (item.Stok > 10)
                                    {
                                        <span class="badge bg-success">Aman</span>
                                    }
                                    else if (item.Stok > 0)
                                    {
                                        <span class="badge bg-warning">Menipis</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Habis</span>
                                    }
                                </td>
                            </tr>
                            no++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">
                                <i class="fas fa-inbox"></i> Belum ada data barang
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-3 text-muted">
    <small>
        <i class="fas fa-info-circle"></i> 
        Laporan dicetak pada: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
    </small>
</div>
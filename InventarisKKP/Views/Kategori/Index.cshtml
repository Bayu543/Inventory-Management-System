@model IEnumerable<InventarisKKP.Models.Kategori>

@{
    ViewData["Title"] = "Daftar Kategori";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-tags"></i> Daftar Kategori</h2>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fas fa-plus"></i> Tambah Kategori
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>No</th>
                        <th>Nama Kategori</th>
                        <th>Jumlah Barang</th>
                        <th>Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.Any() == true)
                    {
                        int no = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@no</td>
                                <td>@(item.NamaKategori ?? "N/A")</td>
                                <td class="text-center">
                                    <span class="badge bg-info">
                                        @(item.Barangs?.Count ?? 0) barang
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="@Url.Action("Edit", new { id = item.KategoriId })" 
                                           class="btn btn-sm btn-warning">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <form method="post" action="@Url.Action("Delete", new { id = item.KategoriId })" 
                                              style="display: inline;" 
                                              onsubmit="return confirm('Yakin ingin menghapus kategori ini?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="fas fa-trash"></i> Hapus
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            no++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted">
                                <div class="py-4">
                                    <i class="fas fa-inbox fa-3x mb-3"></i>
                                    <p class="mb-2">Belum ada data kategori</p>
                                    <a href="@Url.Action("Create")" class="btn btn-primary">
                                        <i class="fas fa-plus"></i> Tambah Kategori Pertama
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model?.Any() == true)
{
    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card bg-primary bg-opacity-10">
                <div class="card-body text-center">
                    <h5 class="card-title">Total Kategori</h5>
                    <h3 class="text-primary">@Model.Count()</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success bg-opacity-10">
                <div class="card-body text-center">
                    <h5 class="card-title">Kategori Terpakai</h5>
                    <h3 class="text-success">@Model.Count(k => k.Barangs?.Any() == true)</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-warning bg-opacity-10">
                <div class="card-body text-center">
                    <h5 class="card-title">Kategori Kosong</h5>
                    <h3 class="text-warning">@Model.Count(k => k.Barangs?.Any() != true)</h3>
                </div>
            </div>
        </div>
    </div>
}
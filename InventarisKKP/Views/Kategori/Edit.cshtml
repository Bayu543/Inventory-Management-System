@model InventarisKKP.Models.Kategori

@{
    ViewData["Title"] = "Edit Kategori";
}

<div class="row">
    <div class="col-md-6">
        <h2><i class="fas fa-edit"></i> Edit Kategori</h2>
        
        <div class="card">
            <div class="card-body">
                <form method="post" action="/Kategori/Edit/@Model.KategoriId">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <input type="hidden" name="KategoriId" value="@Model.KategoriId" />
                    
                    <div class="mb-3">
                        <label for="NamaKategori" class="form-label">Nama Kategori</label>
                        <input type="text" class="form-control" id="NamaKategori" name="NamaKategori" value="@Model.NamaKategori" placeholder="Masukkan nama kategori" required>
                        <span asp-validation-for="NamaKategori" class="text-danger"></span>
                    </div>
                    
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Simpan Perubahan
                        </button>
                        <a href="/Kategori/Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Kembali
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
